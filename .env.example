# JWT signing secret (必須: openssl rand -base64 32 などで生成)
JWT_SECRET=your-super-secret-jwt-key-change-this

# 初期ログイン情報 (初回デプロイ時のデフォルト値)
INITIAL_USERNAME=admin
INITIAL_PASSWORD=password123

# Vercel KV (任意: 設定するとレスポンスタイム・エラー設定がサーバー間で永続化される)
# Vercel ダッシュボード > Storage > KV から自動設定される
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=
